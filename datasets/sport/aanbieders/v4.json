{
  "id": "aanbieders",
  "title": "Sportaanbieders",
  "description": "Sportaanbieders binnen 5 kilometer van de Gemeente Amsterdam",
  "provenance":"Deze data is afkomstig uit het Customer Relationship Managament systeem (CRM) van de Directie Sport en Bos",
  "type": "table",
  "version": "4.0.0",
  "status": "under_development",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "id"
    ],
    "display": "naamAanbieder",
    "properties": {
      "schema": {
        "$ref": "https://schemas.data.amsterdam.nl/schema@v4.0.0#/definitions/schema"
      },
      "id": {
        "type": "integer",
        "description": "Unieke aanduiding van de sportaanbieder.",
        "title": "ID"
      },
      "geometry": {
        "$ref": "https://geojson.org/schema/Point.json",
        "description": "Puntgeometrie van de sportfaciliteit.",
        "title": "Puntgeometrie"
      },
      "postcode": {
        "type": "string",
        "description": "Postcode van de sportlocatie.",
        "title": "Postcode"
      },
      "huisnummer": {
        "type": "string",
        "description": "Huisnummer van de sportlocatie.",
        "title": "Huisnummer"
      },
      "huisletter": {
        "type": "string",
        "description": "Huisletter van de sportlocatie.",
        "title": "Huisletter"
      },
      "huisnummertoevoeging": {
        "type": "string",
        "description": "Huisnummertoevoeging van de sportlocatie.",
        "title": "Huisnummertoevoeging"
      },
      "typeSport": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Het type sport dat de sportaanbieder aanbiedt.",
        "title": "Sport"
      },
      "website": {
        "type": "string",
        "format": "uri",
        "description": "Website van de aanbieder.",
        "title": "Website"
      },
      "naamAanbieder": {
        "type": "string",
        "description": "Naam van de aanbieder.",
        "title": "Naam sportaanbieder"
      },
      "naamSportfaciliteit": {
        "type": "string",
        "description": "Naam van de sportfaciliteit waar de sportaanbieder actief is.",
        "title": "Naam sportfaciliteit"
      },

      "aangepastSporten": {
        "type": "boolean",
        "description": "Indicatie ondersteuning voor aangepast sporten.",
        "title": "Aangepast sporten"
      },
      "stadspasJeugd": {
        "type": "boolean",
        "description": "Indicatie korting sporten via Stadspas voor jeugd.",
        "title": "Stadspas jeugd"
      },
      "stadspas55": {
        "type": "boolean",
        "description": "Indicatie korting sporten via Stadspas voor 55+.",
        "title": "Stadspas 55+"
      },
      "heeftNummeraanduiding": {
        "type": "object",
        "properties": {
          "identificatie": {
            "type": "string"
          },
          "volgnummer": {
            "type": "integer"
          }
        },
        "relation": "benkagg:adresseerbareobjecten",
        "title": "Corresponderende nummeraanduiding",
        "description": "De nummeraanduiding in de Basisregistratie Adressen en Gebouwen die bij deze binnenlocatie hoort"
      }
    }
  }
}
